{
  "name": "pos-terminal-app",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first desktop application for point-of-sale operations.",
  "author": "Puttipong-Aranyapuek",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "package": "npm run verify && electron-forge package",
    "make": "npm run verify && electron-forge make",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^44.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
